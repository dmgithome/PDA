  "pseudocodes": [
    {
      "id": "confirm_checkout_pseudocode",
      "name": "确认取用/归还",
      "description": "提交取用或归还记录的核心逻辑",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/ConsumableCheckoutNewActivity.java",
        "line_range": "1569-1716",
        "method": "confirmCheckout"
      },
      "pseudocode": [
        "function confirmCheckout():",
        "  // 1. 校验",
        "  if 取用模式 and 术间未选择:",
        "    显示错误('请选择术间')",
        "    return",
        "  if 明细列表为空:",
        "    显示错误('请先扫描耗材')",
        "    return",
        "",
        "  // 2. 进入提交状态",
        "  applyUiState(SUBMITTING)",
        "",
        "  // 3. 构造提交数据",
        "  takeItems = []",
        "  returnItems = []",
        "  for each groupItem in consumableGroupList:",
        "    for each rfid in groupItem.rfids:",
        "      item = selectedItemsByRfid[rfid]",
        "      if item缺少RFID:",
        "        显示错误('数据不完整')",
        "        return",
        "      if 取用模式: takeItems.add(item)",
        "      else: returnItems.add(item)",
        "",
        "  // 4. 按来源地点分组提交",
        "  groups = groupBy(items, current_location_id)",
        "  for each (fromId, itemList) in groups:",
        "    apiService.createTakeAndReturnLog(",
        "      operationRoomId,  // 取用时为目标术间ID",
        "      takeItems或returnItems,",
        "      fromId,",
        "      toLocationId",
        "    )",
        "",
        "  // 5. 全部成功后",
        "  recordManager.generateCheckoutRecord() 或 generateReturnRecord()",
        "  显示成功提示",
        "  清空明细",
        "  刷新历史记录",
        "  applyUiState(NEW_CHECKOUT)"
      ]
    },
    {
      "id": "find_consumable_pseudocode",
      "name": "查找耗材状态判断",
      "description": "根据API返回的5个列表判断耗材是否可取用/归还",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/ConsumableCheckoutNewActivity.java",
        "line_range": "798-917",
        "method": "findConsumableInResponse"
      },
      "pseudocode": [
        "function findConsumableInResponse(response, barcode):",
        "  // 1. 检查未入库列表",
        "  if barcode in response.notInStockList:",
        "    显示错误('[条码]耗材未入库')",
        "    return null",
        "",
        "  // 2. 取用模式",
        "  if 取用模式:",
        "    if barcode in response.inStockList:",
        "      return item  // 允许取用",
        "    if barcode in response.takenList:",
        "      显示错误('领用后未归还，请先归还')",
        "      return null",
        "    if barcode in response.consumedList:",
        "      显示错误('耗材已消耗，不能取用')",
        "      return null",
        "    if barcode in response.usedReturnList:",
        "      显示错误('为消耗退回记录，不作为取用对象')",
        "      return null",
        "",
        "  // 3. 归还模式",
        "  if 归还模式:",
        "    if barcode in response.takenList:",
        "      return item  // 允许归还",
        "    if barcode in response.usedReturnList:",
        "      return item  // 允许归还",
        "    if barcode in response.inStockList:",
        "      显示错误('未领用，不可归还')",
        "      return null",
        "    if barcode in response.consumedList:",
        "      显示错误('已消耗，不可归还')",
        "      return null",
        "",
        "  // 4. 未找到",
        "  显示错误('未找到对应的耗材信息')",
        "  return null"
      ]
    },
    {
      "id": "batch_process_pseudocode",
      "name": "微批处理条码查询",
      "description": "将短时间内的多个条码合并为一次API请求",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/ConsumableCheckoutNewActivity.java",
        "line_range": "696-761",
        "methods": ["callApiForBarcode", "processPendingBarcodes"]
      },
      "pseudocode": [
        "BATCH_DELAY_MS = 300",
        "pendingBarcodes = []",
        "",
        "function callApiForBarcode(barcode):",
        "  synchronized(pendingBarcodes):",
        "    if barcode not in pendingBarcodes:",
        "      pendingBarcodes.add(barcode)",
        "  // 重置延迟计时器",
        "  handler.removeCallbacks(batchProcessRunnable)",
