        "function createTakeAndReturnLog(operationRoomId, takeItems, returnItems, fromLocationId, toLocationId):",
        "  // 1. 校验",
        "  if 用户未登录: callback.onFailure('用户未登录')",
        "  if API未配置: callback.onFailure('API服务器地址未配置')",
        "  cabinetId = BarcodeValidator.getCabinetId()",
        "  if cabinetId <= 0: callback.onFailure('请先配置货柜ID')",
        "",
        "  // 2. 构造请求体",
        "  body = {",
        "    userID: currentUser.userId,",
        "    openDoorTime: now,",
        "    closeDoorTime: now,",
        "    operationroomId: operationRoomId,",
        "    cabinetID: cabinetId,",
        "    from_location_id: fromLocationId ?? cabinetId,",
        "    to_location_id: toLocationId,",
        "    takeList: [],",
        "    returnList: []",
        "  }",
        "",
        "  // 3. 填充明细",
        "  lineId = 1",
        "  for item in takeItems:",
        "    body.takeList.add({",
        "      id: lineId++,",
        "      rfid: item.rfid,",
        "      batch, expiryDate, code, name, spec, manufacturer, brand, unit",
        "    })",
        "  for item in returnItems:",
        "    body.returnList.add({",
        "      id: lineId++,",
        "      rfid: item.rfid,",
        "      ...,",
        "      expected_current_location_id: item.currentLocationId  // 并发校验",
        "    })",
        "",
        "  // 4. 发送请求",
        "  response = sendHttpRequest(CREATE_TAKE_RETURN_LOG, 'POST', body)",
        "  if response.status != 200:",
        "    throw Exception(response.message)",
        "",
        "  // 5. 返回结果",
        "  result = {",
        "    recordId: response.data.recordId,",
        "    takeCount: response.data.takeCount,",
        "    returnCount: response.data.returnCount",
        "  }",
        "  callback.onSuccess(result)"
      ]
