  "pseudocodes": [
    {
      "id": "pseudo_handle_tag_scanned",
      "name": "handleTagScanned 标签处理",
      "description": "处理单个 RFID 标签的核心逻辑",
      "code_ref": {
        "file": "app/src/main/java/com/pda/hcw/InventoryActivity.java",
        "lines": "641-691"
      },
      "pseudocode": [
        "FUNCTION handleTagScanned(tag):",
        "  IF uiState != EXECUTING OR currentTask == null OR rawStatus != 'running':",
        "    RETURN",
        "  ",
        "  epcRawHex = bytesToHexString(tag.EpcId)",
        "  epc = EpcFormatter.normalizeOnReceive(epcRawHex)",
        "  IF epc is empty:",
        "    RETURN",
        "  ",
        "  // 本轮去重",
        "  IF epc IN seenEpcsThisRun:",
        "    RETURN",
        "  seenEpcsThisRun.add(epc)",
        "  ",
        "  // 提交级去重",
        "  isNewTag = false",
        "  IF epc NOT IN submittedRfids:",
        "    checkoutDb.recordPendingScan(taskId, epc)",
        "    isNewTag = true",
        "  ",
        "  // 蜂鸣反馈（业务增量模式）",
        "  IF NOT beepModeRaw:",
        "    rfidBeepManager.requestBeep()",
        "  ",
        "  // 更新本地会话并刷新 UI",
        "  IF isNewTag AND inventorySession != null:",
        "    inventorySession.onTag(epc)",
        "    POST TO UI_THREAD:",
        "      更新表头统计",
        "      updateRoomGridFromSession()"
      ]
    },
    {
      "id": "pseudo_session_on_tag",
      "name": "InventorySession.onTag 标签入账",
      "description": "将扫描到的标签分类为已盘或盈余",
      "code_ref": {
        "file": "app/src/main/java/com/pda/hcw/inventory/InventorySession.java",
        "lines": "121-142"
      },
      "pseudocode": [
        "FUNCTION onTag(rawRfid):",
        "  raw = safeRfid(rawRfid)",
        "  IF raw is empty:",
        "    RETURN false",
        "  ",
        "  // 简单去重",
        "  IF raw IN seen:",
        "    RETURN false",
        "  seen.add(raw)",
        "  ",
        "  canonical = canonicalize(raw)",
        "  IF canonical != null AND canonical IN allPlanned:",
        "    // 计划内标签：找到所属地点并标记已盘",
        "    FOR EACH (roomId, plannedSet) IN plannedByRoom:",
        "      IF canonical IN plannedSet:",
        "        countedByRoom[roomId].add(canonical)",
        "        countedAll.add(canonical)",
        "        BREAK",
        "  ELSE:",
        "    // 盈余标签",
        "    surplus.add(raw)",
        "  ",
        "  RETURN true"
      ]
    },
    {
      "id": "pseudo_submit_batch",
      "name": "submitCurrentBatch 批次提交",
      "description": "将待提交的 RFID 批量上传到后端",
      "code_ref": {
        "file": "app/src/main/java/com/pda/hcw/InventoryActivity.java",
        "lines": "897-967"
      },
      "pseudocode": [
        "FUNCTION submitCurrentBatch(forceToastOnEmpty):",
        "  // 前置校验",
        "  IF currentTask == null OR rawStatus != 'running':",
        "    IF forceToastOnEmpty: showInfo('当前任务状态不允许提交')",
        "    RETURN",
        "  IF isSubmittingBatch:",
        "    IF forceToastOnEmpty: showInfo('上一批正在提交')",
        "    RETURN",
        "  ",
        "  batch = checkoutDb.pendingScans(taskId)",
        "  IF batch is empty:",
        "    IF forceToastOnEmpty: showInfo('无新标签需要提交')",
        "    RETURN",
        "  ",
        "  isSubmittingBatch = true",
        "  showInfo('正在提交...')",
        "  ",
        "  CALL API submitInventoryScanBatch(taskId, batch):",
        "    ON SUCCESS(result):",
        "      更新 currentTask 统计字段",
        "      submittedRfids.addAll(batch)",
        "      checkoutDb.acknowledgeScans(taskId, batch)",
        "      updateHeaderStats()",
        "      reloadTaskDetailAndSession(false)",
        "      showSuccess('提交成功')",
        "      isSubmittingBatch = false",
        "    ON FAILURE(e):",
        "      showError('提交失败')",
        "      // 待提交标签保留在本地数据库，重开应用后可以重试",
        "      isSubmittingBatch = false"
      ]
    },
    {
      "id": "pseudo_rebuild_session",
      "name": "rebuildSessionFromDetail 会话重建",
      "description": "从后端任务明细重建内存态会话",
      "code_ref": {
        "file": "app/src/main/java/com/pda/hcw/InventoryActivity.java",
        "lines": "411-469"
      },
      "pseudocode": [
        "FUNCTION rebuildSessionFromDetail(taskId, detail):",
        "  inventorySession = new InventorySession(taskId)",
        "  IF detail is null OR detail.items is empty:",
        "    清空地点网格",
        "    RETURN",
        "  ",
        "  // 构建计划列表",
        "  plan = []",
        "  FOR EACH item IN detail.items:",
        "    IF item.snapshotStatus is null:",
        "      CONTINUE",
        "    IF item.rfid is empty:",
        "      CONTINUE",
        "    plan.add(new InventoryPlanItem(...))",
        "  ",
        "  inventorySession.loadPlan(plan)",
        "  ",
        "  // 写入状态快照并标记已盘",
        "  FOR EACH item IN detail.items:",
        "    inventorySession.setStatusFor(rfid, snapshotStatus, latestStatus)",
        "    IF item.scanStatus == 'scanned':",
        "      inventorySession.onTag(rfid)",
        "  合并该任务在本地等待提交的标签",
        "  ",
        "  updateRoomGridFromSession()"
      ]
    },
    {
      "id": "pseudo_rfid_polling",
      "name": "RFID 轮询读取",
      "description": "后台线程轮询读取 RFID 标签的核心逻辑",
      "code_ref": {
        "file": "app/src/main/java/com/pda/hcw/InventoryActivity.java",
        "lines": "1164-1220"
      },
      "pseudocode": [
        "FUNCTION rfidRunnable.run():",
        "  IF NOT isRFIDActive OR uhfManager not initialized:",
        "    RETURN",
        "  ",
        "  TRY:",
        "    // 先尝试实时读取",
        "    tagList = uhfManager.tagInventoryRealTime()",
        "    ",
        "    // 若为空，回退到定时读取",
        "    IF tagList is empty:",
        "      tagList = uhfManager.tagInventoryByTimer(50ms)",
        "    ",
        "    IF tagList is not empty:",
        "      emptyReadRounds = 0",
        "      currentPollInterval = MIN_INTERVAL (200ms)",
        "      FOR EACH tag IN tagList:",
        "        IF beepModeRaw: rfidBeepManager.requestBeep()",
        "        handleTagScanned(tag)",
        "    ELSE:",
        "      // 退避策略",
        "      emptyReadRounds++",
        "      currentPollInterval = min(currentPollInterval * 2, MAX_INTERVAL)",
        "      ",
        "      // 空读自恢复",
        "      IF emptyReadRounds >= 4:",
        "        uhfManager.asyncStopReading()",
        "        sleep(30ms)",
        "        uhfManager.asyncStartReading()",
        "        emptyReadRounds = 0",
        "  CATCH Exception:",
        "    Log error",
        "  ",
        "  // 调度下一轮",
        "  IF isRFIDActive:",
        "    rfidBgHandler.postDelayed(this, currentPollInterval)"
      ]
    }
  ]
}
