{
  "id": "inventory",
  "name": "盘点模块",
  "description": "Android PDA 库存盘点功能，支持 RFID 批量扫描、实时统计、差异分析。采用状态机驱动 UI，任务生命周期由 Web 端管理，PDA 仅负责扫描与提交。",
  "code_refs": [
    {"file": "app/src/main/java/com/pda/hcw/InventoryActivity.java"},
    {"file": "app/src/main/java/com/pda/hcw/InventoryDatabase.java"},
    {"file": "app/src/main/java/com/pda/hcw/inventory/InventorySession.java"},
    {"file": "app/src/main/java/com/pda/hcw/inventory/InventoryRoomStatus.java"},
    {"file": "app/src/main/java/com/pda/hcw/inventory/InventoryPlanItem.java"}
  ],
  "flows": [
