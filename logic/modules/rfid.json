  "pseudocodes": [
    {
      "id": "epc_normalize_pseudocode",
      "name": "EPC标准化伪代码",
      "description": "将各种格式的EPC值标准化为18位标准值",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/rfid/EpcFormatter.java",
        "lines": "22-56"
      },
      "pseudocode": [
        "FUNCTION normalizeOnReceive(input):",
        "  IF input IS NULL THEN RETURN NULL",
        "  s = TRIM(input)",
        "  IF s IS EMPTY THEN RETURN s",
        "",
        "  // 规则1: 前缀000000，长度24",
        "  IF LENGTH(s) == 24 AND STARTS_WITH(s, '000000') THEN",
        "    RETURN SUBSTRING(s, 6)  // 取后18位",
        "",
        "  // 规则2: 后缀00，长度20",
        "  IF LENGTH(s) == 20 AND ENDS_WITH(s, '00') THEN",
        "    RETURN SUBSTRING(s, 0, 18)  // 取前18位",
        "",
        "  // HEX形态检测",
        "  IF isHexLike(s) THEN",
        "    // 形态A: HEX前缀000000，长度42",
        "    IF LENGTH(s) == 42 AND STARTS_WITH(s, '000000') THEN",
        "      tail = SUBSTRING(s, 6)  // 取后36位HEX",
        "      decoded = ASCII_DECODE(tail)",
        "      IF decoded != NULL AND LENGTH(decoded) == 18 THEN",
        "        RETURN decoded",
        "",
        "    // 形态B: HEX长度40，解码后20位且以00结尾",
        "    IF LENGTH(s) == 40 THEN",
        "      decoded = ASCII_DECODE(s)",
        "      IF decoded != NULL AND LENGTH(decoded) == 20 AND ENDS_WITH(decoded, '00') THEN",
        "        RETURN SUBSTRING(decoded, 0, 18)",
        "",
        "  // 未匹配任何规则，返回原值",
        "  RETURN s"
      ]
    },
    {
      "id": "uhf_init_pseudocode",
      "name": "UHF初始化伪代码",
      "description": "初始化UHF模块的完整流程，包含功率降级逻辑",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/rfid/UHFManager.java",
        "lines": "49-136"
      },
      "pseudocode": [
        "FUNCTION initialize(context):",
        "  TRY",
        "    this.context = context",
        "    this.sharedUtil = NEW SharedUtil(context)",
        "",
        "    // 获取UHF实例",
        "    uhfReader = UHFRManager.getInstance()",
        "    IF uhfReader IS NULL THEN RETURN FALSE",
        "",
        "    // 尝试设置用户配置的功率",
        "    userPower = sharedUtil.getPower()",
        "    result = uhfReader.setPower(userPower, userPower)",
        "",
        "    IF result == MT_OK_ERR THEN",
        "      LOG '功率设置成功: ' + userPower + 'dBm'",
        "    ELSE",
        "      // 降级到30dBm",
        "      LOG '功率设置失败，降级到30dBm'",
        "      result = uhfReader.setPower(30, 30)",
        "      IF result != MT_OK_ERR THEN RETURN FALSE",
        "",
        "    // 设置频段",
        "    uhfReader.setRegion(sharedUtil.getWorkFreq())",
        "",
        "    // 设置其他参数",
        "    uhfReader.setGen2session(sharedUtil.getSession())",
        "    uhfReader.setTarget(sharedUtil.getTarget())",
        "    uhfReader.setQvaule(sharedUtil.getQvalue())",
        "    uhfReader.setFastID(sharedUtil.getFastId())",
        "",
        "    isInitialized = TRUE",
        "    RETURN TRUE",
        "",
        "  CATCH Exception",
        "    LOG '初始化失败'",
        "    RETURN FALSE"
      ]
    },
    {
      "id": "beep_request_pseudocode",
      "name": "蜂鸣请求伪代码",
      "description": "带限流的蜂鸣请求处理",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/rfid/RfidBeepManager.java",
        "lines": "56-70"
      },
      "pseudocode": [
        "FUNCTION requestBeep():",
        "  IF NOT active OR NOT enabled THEN RETURN",
        "",
        "  // 计算最小间隔",
        "  gap = multiMode ? 40ms : 120ms",
        "  now = CURRENT_TIME_MS()",
        "",
        "  // 限流检查",
        "  IF now - lastBeepAt < gap THEN RETURN",
        "",
        "  TRY",
        "    // 确保ToneGenerator存在",
        "    IF toneGenerator IS NULL THEN",
        "      toneGenerator = NEW ToneGenerator(STREAM_MUSIC, 100)",
        "",
        "    // 选择音色和时长",
        "    tone = multiMode ? TONE_PROP_BEEP : TONE_PROP_ACK",
        "    duration = multiMode ? 60ms : 120ms",
        "",
        "    // 发声",
        "    toneGenerator.startTone(tone, duration)",
        "    lastBeepAt = now",
        "",
        "  CATCH Exception",
        "    LOG '蜂鸣失败'"
      ]
    },
    {
      "id": "bytes_to_hex_pseudocode",
      "name": "字节数组转HEX字符串伪代码",
      "description": "将RFID标签的EpcId字节数组转换为十六进制字符串",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/rfid/UHFManager.java",
        "lines": "630-640"
      },
      "pseudocode": [
        "FUNCTION bytesToHexString(bytes):",
        "  IF bytes IS NULL OR LENGTH(bytes) == 0 THEN",
        "    RETURN ''",
        "",
        "  result = ''",
        "  FOR EACH byte IN bytes DO",
        "    // 转换为无符号值并格式化为2位HEX",
        "    hexValue = FORMAT('%02X', byte AND 0xFF)",
        "    result = result + hexValue",
        "",
        "  RETURN result"
      ]
    },
    {
      "id": "hex_to_ascii_pseudocode",
      "name": "HEX转ASCII伪代码",
      "description": "将HEX字符串按ASCII解码为字符串",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/rfid/EpcFormatter.java",
        "lines": "69-81"
      },
      "pseudocode": [
        "FUNCTION tryAsciiFromHex(hex):",
        "  TRY",
        "    IF hex IS NULL OR LENGTH(hex) % 2 != 0 THEN",
        "      RETURN NULL",
        "",
        "    result = ''",
        "    FOR i = 0 TO LENGTH(hex) STEP 2 DO",
        "      // 取2位HEX，解析为整数",
        "      byteValue = PARSE_INT(SUBSTRING(hex, i, i+2), 16)",
        "      // 转换为字符",
        "      result = result + CHAR(byteValue)",
        "",
        "    RETURN result",
        "",
        "  CATCH Exception",
        "    RETURN NULL"
      ]
    }
  ]
