        "  LOG '检查登录安全性: ' + userId",
        "  ",
        "  // 检查登录频率",
        "  frequencyResult = checkLoginFrequency(deviceId)",
        "  IF frequencyResult.isAbnormal():",
        "    RETURN frequencyResult",
        "  ",
        "  // 检查用户切换",
        "  switchingResult = checkUserSwitching(deviceId)",
        "  IF switchingResult.isAbnormal():",
        "    RETURN switchingResult",
        "  ",
        "  // 检查用户状态",
        "  statusResult = checkUserStatus(userId)",
        "  IF statusResult.isAbnormal():",
        "    RETURN statusResult",
        "  ",
        "  RETURN SecurityResult(false, '登录正常', 1)"
      ]
