      "states": [
        {
          "id": "inactive",
          "name": "未激活",
          "description": "无活跃会话，isActive=false, currentUser=null"
        },
        {
          "id": "active",
          "name": "激活",
          "description": "有活跃会话，isActive=true, currentUser!=null"
        },
        {
          "id": "warning",
          "name": "预警",
          "description": "会话即将超时（超时前60秒），触发onSessionWarning回调"
        },
        {
          "id": "timeout",
          "name": "超时",
          "description": "会话已超时，触发onSessionTimeout回调"
        }
      ],
      "transitions": [
        {
          "from": "inactive",
          "to": "active",
          "trigger": "startSession(user)",
          "actions": ["设置currentUser", "设置isActive=true", "记录lastActivityTime", "保存会话信息", "启动超时检测", "记录登录日志"]
        },
        {
          "from": "active",
          "to": "active",
          "trigger": "updateActivity()",
          "actions": ["更新lastActivityTime", "重启超时检测"]
        },
        {
          "from": "active",
          "to": "warning",
          "trigger": "剩余时间 <= 60秒",
          "actions": ["触发onSessionWarning回调"]
        },
        {
          "from": "active",
          "to": "inactive",
          "trigger": "endSession(reason)",
          "actions": ["记录登出日志", "设置isActive=false", "设置currentUser=null", "停止超时检测", "清除会话信息", "触发onSessionDestroyed回调"]
        },
        {
          "from": "warning",
          "to": "inactive",
          "trigger": "超时到达且不在白名单",
          "actions": ["调用endSession('会话超时')", "触发onSessionTimeout回调"]
        },
        {
          "from": "warning",
          "to": "active",
          "trigger": "超时到达但在白名单",
          "actions": ["更新lastActivityTime", "重启超时检测"]
        },
        {
          "from": "active",
          "to": "inactive",
          "trigger": "forceEndSession(reason)",
          "actions": ["调用endSession(reason)"]
        }
      ]
    },
