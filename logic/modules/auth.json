      "id": "start_timeout_timer_pseudocode",
      "name": "会话超时检测伪代码",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/SessionManager.java",
        "method": "startTimeoutTimer",
        "lines": "195-243"
      },
      "pseudocode": [
        "FUNCTION startTimeoutTimer():",
        "  stopTimeoutTimer()  // 先停止现有计时器",
        "  ",
        "  remaining = getRemainingTime()",
        "  ",
        "  IF remaining <= 0:",
        "    IF isIdleExemptForeground():",
        "      lastActivityTime = NOW",
        "      LOG '会话超时命中白名单，已自动续期'",
        "      startTimeoutTimer()  // 递归重启",
        "      RETURN",
        "    ",
        "    LOG '会话超时，自动登出'",
        "    endSession('会话超时')",
        "    IF listener != null:",
        "      listener.onSessionTimeout()",
        "    RETURN",
        "  ",
        "  // 设置预警回调（超时前60秒）",
        "  warnDelay = remaining - 60000",
        "  IF warnDelay > 0 AND listener != null:",
        "    SCHEDULE warningRunnable AFTER warnDelay:",
        "      rem = getRemainingTime()",
        "      IF isActive AND rem > 0:",
        "        listener.onSessionWarning(rem)",
        "  ",
        "  // 设置超时回调",
        "  SCHEDULE timeoutRunnable AFTER remaining:",
        "    IF NOT isActive:",
        "      RETURN",
        "    IF isIdleExemptForeground():",
        "      lastActivityTime = NOW",
        "      LOG '会话超时命中白名单，已自动续期'",
        "      startTimeoutTimer()",
        "      RETURN",
        "    LOG '会话超时，自动登出'",
        "    endSession('会话超时')",
        "    IF listener != null:",
        "      listener.onSessionTimeout()",
        "  ",
        "  LOG '启动会话超时检测，remaining=' + remaining + 'ms'"
      ]
    },
