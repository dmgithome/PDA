      "id": "parse_login_response_pseudocode",
      "name": "登录响应解析伪代码",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/NetworkAuthService.java",
        "method": "parseLoginResponse",
        "lines": "186-249"
      },
      "pseudocode": [
        "FUNCTION parseLoginResponse(responseBody, username, httpCode):",
        "  TRY:",
        "    json = PARSE_JSON(responseBody)",
        "    ",
        "    status = json.status OR json.code OR -1",
        "    message = json.message OR json.msg OR ''",
        "    data = json.data",
        "    ",
        "    tokenInData = data?.token",
        "    tokenOk = tokenInData IS NOT EMPTY",
        "    statusOk = status IN [0, 200, 201]",
        "    ",
        "    IF NOT statusOk AND NOT tokenOk:",
        "      friendly = buildFriendlyErrorMessage(httpCode, status, message)",
        "      THROW Exception(friendly)",
        "    ",
        "    IF data IS NULL:",
        "      THROW Exception('登录失败：响应缺少data')",
        "    ",
        "    token = data.token",
        "    sessionId = data.sid",
        "    ",
        "    IF token IS EMPTY OR sessionId IS EMPTY:",
        "      THROW Exception('登录失败：响应缺少token或sid')",
        "    ",
        "    user = data.user",
        "    IF user IS NULL:",
        "      THROW Exception('登录失败：响应缺少user信息')",
        "    ",
        "    userId = user.id",
        "    realName = user.name OR username",
        "    department = user.deptName OR ''",
        "    userRole = user.role OR 'USER'",
        "    ",
        "    successMessage = message OR '登录成功'",
        "    ",
        "    userInfo = UserInfo.createFromApiResponse(...)",
        "    RETURN LoginResponse(userInfo, successMessage)",
        "  ",
        "  CATCH JSONException:",
        "    TRY:",
        "      // 尝试从原始响应提取错误信息",
        "      friendly = buildFriendlyErrorMessage(httpCode, status, message)",
        "      THROW Exception(friendly)",
        "    CATCH:",
        "      THROW Exception(buildFriendlyErrorMessage(httpCode, httpCode, ''))"
      ]
    }
  ]
}
