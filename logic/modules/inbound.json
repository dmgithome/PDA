      "id": "handle_inbound_inventory_check",
      "name": "入库库存状态校验",
      "description": "根据耗材库存状态决定是否允许入库",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/InboundAcceptanceActivity.java",
        "lines": "785-838"
      },
      "pseudocode": [
        "function handleInboundInventoryCheck(order, rfid, resp):",
        "  if isFinishing(): return",
        "  if order == null or order.code为空: return",
        "  ",
        "  // 确保订单仍存在于当前列表",
        "  target = orders.find(o => o.code == order.code)",
        "  if target == null:",
        "    showInfo('当前入库单已更新，忽略标签 ' + rfid)",
        "    return",
        "  ",
        "  // 判断RFID在哪个状态列表",
        "  inNotInStock = resp.notInStockList.contains(rfid)",
        "  inInStock = resp.inStockList.containsRfid(rfid)",
        "  inTaken = resp.takenList.containsRfid(rfid)",
        "  inConsumed = resp.consumedList.containsRfid(rfid)",
        "  inUsedReturn = resp.usedReturnList.containsRfid(rfid)",
        "  ",
        "  // 仅notInStock且不在其他列表时允许入库",
        "  if inNotInStock and not (inInStock or inTaken or inConsumed or inUsedReturn):",
        "    performAddDelta(target, rfid)",
        "    return",
        "  ",
        "  // 其他状态给出具体错误提示",
        "  if inInStock:",
        "    showError('耗材已在库存中，无法重复入库')",
        "  else if inTaken:",
        "    showError('耗材处于取用未归还状态')",
        "  else if inConsumed:",
        "    showError('耗材已消耗')",
        "  else if inUsedReturn:",
        "    showError('耗材为消耗退回记录')",
        "  else:",
        "    showError('状态未知，暂不处理')"
      ]
    },
