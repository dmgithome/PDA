      "pseudocode": [
        "function processPendingInboundRfids():",
        "  synchronized(pendingRfidToOrder):",
        "    if pendingRfidToOrder.isEmpty():",
        "      return",
        "    toProcess = copy(pendingRfidToOrder)",
        "    pendingRfidToOrder.clear()",
        "  ",
        "  rfidList = toProcess.keys()",
        "  Log('Batch processing ' + rfidList.size() + ' RFIDs')",
        "  ",
        "  ConsumableApiService.queryConsumableInfoList(rfidList, {",
        "    onSuccess: (resp) => {",
        "      for each (rfid, order) in toProcess:",
        "        handleInboundInventoryCheck(order, rfid, resp)",
        "    },",
        "    onFailure: (e) => {",
        "      showError('批量获取耗材库存状态失败')",
        "    }",
        "  })"
      ]
