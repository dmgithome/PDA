      "pseudocode": [
        "function addDelta(order, rfid):",
        "  // 确保在主线程执行",
        "  if not isMainThread():",
        "    runOnUiThread(() => addDelta(order, rfid))",
        "    return",
        "  ",
        "  if order == null or order.code为空: return",
        "  ",
        "  // 检查是否已在本次会话中添加过",
        "  existing = deltaByOrder.get(order.code)",
        "  if existing != null and rfid in existing:",
        "    return  // 已添加，跳过",
        "  ",
        "  // 加入待处理队列",
        "  synchronized(pendingRfidToOrder):",
        "    if rfid not in pendingRfidToOrder:",
        "      pendingRfidToOrder.put(rfid, order)",
        "  ",
        "  // 延迟300ms批量处理",
        "  inboundBatchHandler.removeCallbacks(inboundBatchRunnable)",
        "  inboundBatchHandler.postDelayed(inboundBatchRunnable, 300)"
      ]
    }
