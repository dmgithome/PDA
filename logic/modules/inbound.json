    {
      "id": "fetch_pending_orders",
      "name": "拉取待上架入库单",
      "description": "从服务端获取待上架的入库单据列表",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/InboundApiService.java",
        "lines": "59-167"
      },
      "pseudocode": [
        "function fetchPendingOrders(callback):",
        "  if 用户未登录:",
        "    return 失败('用户未登录')",
        "  if API地址未配置:",
        "    return 失败('API服务器地址未配置')",
        "  ",
        "  response = GET /api/stock/getWarehousingOrder",
        "  if response.status != 200:",
        "    return 失败(response.message)",
        "  ",
        "  orders = []",
        "  for each orderJson in response.data:",
        "    order = new InboundOrder()",
        "    order.code = orderJson.orderNo",
        "    order.total = orderJson.number",
        "    order.accepted = orderJson.shelfedNumber",
        "    order.rpNameTo = orderJson.rpNameTo",
        "    ",
        "    plannedRfids = Set()",
        "    details = []",
        "    for each level1 in orderJson.children:",
        "      for each item in level1.children:",
        "        rfid = EpcFormatter.normalizeOnReceive(item.rfid)",
        "        detail = new InboundOrderDetail(rfid, item.*)",
        "        detail.baseMatched = item.isShelfed",
        "        details.add(detail)",
        "        if not item.isShelfed:",
        "          plannedRfids.add(rfid)",
        "    ",
        "    order.plannedRfids = plannedRfids",
        "    order.details = details",
        "    orders.add(order)",
        "  ",
        "  return 成功(orders)"
      ]
    },
    {
      "id": "submit_inbound_order",
      "name": "提交有单入库上架",
      "description": "将本次验收的RFID列表提交到服务端",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/InboundApiService.java",
        "lines": "169-292"
      },
      "pseudocode": [
        "function submitInboundOrder(order, rfids, spdBindingId, callback):",
        "  // 参数校验",
        "  if order == null: return 失败('未找到入库单信息')",
        "  if 用户未登录: return 失败('用户未登录')",
        "  if sdCode为空: return 失败('请先配置sdCode')",
        "  if cabinetId <= 0: return 失败('请先配置货柜ID')",
        "  if rfids为空: return 失败('无新增可提交')",
        "  if spdBindingId <= 0: return 失败('请选择SPD仓库')",
        "  ",
        "  // 构建items数组",
        "  items = []",
        "  for each rfid in rfids:",
        "    item = {",
        "      rfid: rfid,",
        "      cabinetID: cabinetId,",
        "      orderNo: order.code,",
        "      quantity: detail.quantity or 1,",
        "      // 其他字段从detailByRfid获取",
        "    }",
        "    items.add(item)",
        "  ",
        "  // 构建请求体",
        "  body = {",
        "    userID: currentUser.userId,",
        "    userName: currentUser.username,",
        "    sdCode: sdCode,",
        "    orderNo: order.code,",
        "    type: 'hasOrder',",
        "    cabinetID: cabinetId,",
        "    createDate: now(),",
        "    items: items,",
        "    target_location_id: 中心库ID,",
        "    bindingId: spdBindingId",
        "  }",
        "  ",
        "  response = POST /api/stock/hasOrderInbound body",
        "  if response.status in [200, 0] and response.data有效:",
        "    return 成功(true)",
        "  else:",
        "    return 失败(response.msg)"
      ]
    },
    {
      "id": "handle_rfid_tag",
      "name": "处理RFID标签",
      "description": "RFID轮询读取到标签后的处理逻辑",
      "code_ref": {
        "file": "/Users/dm/code/PDA/app/src/main/java/com/pda/hcw/InboundAcceptanceActivity.java",
        "lines": "634-654"
      },
      "pseudocode": [
        "function handleRfidTag(tag):",
        "  epcHex = bytesToHexString(tag.EpcId)",
        "  if epcHex为空: return",
        "  ",
        "  if beepModeRaw:",
        "    rfidBeepManager.requestBeep()  // 原始蜂鸣",
        "  ",
        "  rfid18 = EpcFormatter.normalizeOnReceive(epcHex)",
        "  if rfid18为空: return  // 非合规格式，过滤",
        "  ",
        "  if rfid18 in seenEpcsThisRun:",
        "    return  // 本轮已处理，去重",
        "  seenEpcsThisRun.add(rfid18)",
        "  ",
        "  order = findOrderByPlannedRfid(rfid18)",
        "  if order == null:",
        "    return  // 非待上架RFID，静默过滤",
        "  ",
        "  addDelta(order, rfid18)  // 加入本次增量",
        "  ",
        "  if not beepModeRaw:",
        "    rfidBeepManager.requestBeep()  // 业务蜂鸣",
        "  ",
        "  epcAdapter.addEpc(rfid18)  // 更新UI滚动列表"
      ]
    },
