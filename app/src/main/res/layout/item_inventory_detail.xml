<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 主要信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- 序号 -->
            <TextView
                android:id="@+id/serial_no_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:background="@drawable/shape_rounded_corner"
                android:padding="4dp"
                android:minWidth="24dp"
                android:gravity="center"/>

            <!-- 商品编号 -->
            <TextView
                android:id="@+id/product_code_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="PC001"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <!-- 状态 -->
            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已盘"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/shape_rounded_corner"
                android:padding="4dp"
                android:paddingHorizontal="8dp"/>

        </LinearLayout>

        <!-- 耗材信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp">

            <!-- 通用名称 -->
            <TextView
                android:id="@+id/common_name_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="一次性使用无菌注射器"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp"/>

            <!-- 规格和生产厂家 -->
            <TextView
                android:id="@+id/spec_manufacturer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="规格：5ml   生产厂家：某医疗器械有限公司"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- 扫描信息行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- EPC编码 -->
            <TextView
                android:id="@+id/epc_code_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EPC:300000000000000000000001"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- 扫描时间 -->
            <TextView
                android:id="@+id/scan_time_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30:25"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>

        </LinearLayout>

        <!-- 操作按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 信号强度 -->
            <TextView
                android:id="@+id/rssi_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="信号强度：-65dBm"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>

            <!-- 移除按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/remove_button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="移除"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                app:cornerRadius="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/error"
                android:textColor="@color/error"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>