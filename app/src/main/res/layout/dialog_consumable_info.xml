<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扫码成功"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- 耗材信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface_variant"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- 商品编号 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dialog_product_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="商品编号：PC001"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:singleLine="true"/>

            </HorizontalScrollView>

            <!-- 条码号 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dialog_barcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="条码号：123456789"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:singleLine="true"/>

            </HorizontalScrollView>

            <!-- 通用名称 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dialog_common_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通用名称：一次性医用口罩"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"/>

            </HorizontalScrollView>

            <!-- 规格型号 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dialog_specification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="规格型号：17.5cm×9.5cm"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"/>

            </HorizontalScrollView>

            <!-- 生产企业 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/dialog_manufacturer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="生产企业：某某医疗器械有限公司"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"/>

            </HorizontalScrollView>

            <!-- 数量单位 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/dialog_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="单位：盒"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"/>

            </HorizontalScrollView>

        </LinearLayout>

        <!-- 按钮区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_cancel_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/common_cancel"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/surface_variant"
                android:textColor="@color/text_primary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialog_add_button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="添加到明细"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/primary"
                android:textColor="@color/surface"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>