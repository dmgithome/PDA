<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".InventoryActivity">

    <!-- 主内容区域 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <!-- 顶部应用栏 -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="4dp">

            <include
                android:id="@+id/toolbar"
                layout="@layout/toolbar_custom" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- 主要内容区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="?attr/actionBarSize"
            android:orientation="vertical">

            <!-- 顶部任务条：任务单号 | 状态 -->
            <LinearLayout
                android:id="@+id/task_header_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@color/surface"
                android:elevation="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/task_code_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="任务单号：—"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/task_state_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/shape_rounded_corner"
                    android:padding="4dp"
                    android:paddingHorizontal="8dp"/>
            </LinearLayout>

            <!-- 统计表头：仅执行中/已结束显示 -->
            <LinearLayout
                android:id="@+id/stats_header_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:background="@color/surface"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/header_total_planned"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总待盘：0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/header_counted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="盘毕：0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/header_uncounted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未盘：0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/header_surplus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="盈余：0"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 状态容器 -->
            <FrameLayout
                android:id="@+id/state_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- NO_TASK：居中新建按钮 -->
                <FrameLayout
                    android:id="@+id/view_no_task"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_create_task_center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="新建盘点任务"
                        android:textSize="16sp"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_gravity="center"/>
                </FrameLayout>

                <!-- PENDING：摘要 + 底部刷新/确认 -->
                <LinearLayout
                    android:id="@+id/view_pending"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_pending_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="尚未拉取库存"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"/>

                    <!-- 预览网格（待确认阶段也展示耗材屋与术间，两列，不启用扫描） -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/pending_grid_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_location_summary"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="0"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="@color/surface"
                        android:elevation="4dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pending_refresh"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="刷新库存"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pending_confirm"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="确认任务"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- EXECUTING：网格 + 结束盘点 -->
                <LinearLayout
                    android:id="@+id/view_executing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 两列网格 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/location_summary_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_location_summary"/>

                    <!-- 操作按钮：作废 + 结束盘点 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="@color/surface"
                        android:elevation="4dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_void_task"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="作废"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:textColor="@color/error"
                            app:strokeColor="@color/error"/>
                        <View
                            android:layout_width="12dp"
                            android:layout_height="1dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_end_inventory"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="结束盘点"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- FINISHED：差异记录明细 + 导出 -->
                <LinearLayout
                    android:id="@+id/view_finished"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 标题 -->
                    <TextView
                        android:id="@+id/tv_diff_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="盘点差异记录"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:padding="16dp"/>

                    <!-- 汇总统计 -->
                    <TextView
                        android:id="@+id/tv_diff_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        tools:text="缺失：3 条   盈余：1 条"/>

                    <!-- 差异类型 Tab（缺失 / 盈余） -->
                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/inventory_diff_tabs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        app:tabMode="fixed"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="@color/primary"
                        app:tabSelectedTextColor="@color/primary"
                        app:tabTextColor="@color/text_tertiary"
                        app:tabIndicatorHeight="3dp">

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="缺失"/>

                        <com.google.android.material.tabs.TabItem
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="盈余"/>

                    </com.google.android.material.tabs.TabLayout>

                    <!-- 空态提示 -->
                    <TextView
                        android:id="@+id/tv_diff_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="32dp"
                        android:paddingBottom="32dp"
                        android:text="当前类别暂无差异明细"
                        android:textColor="@color/text_tertiary"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                    <!-- 差异明细列表 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/diff_recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:padding="16dp"
                        android:clipToPadding="false"
                        tools:listitem="@layout/item_inventory_diff"/>

                    <!-- 导出按钮 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="@color/surface"
                        android:elevation="4dp">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_export_csv"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="导出CSV"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>
                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- RFID状态显示（悬浮） -->
        <LinearLayout
            android:id="@+id/rfid_status_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom"
            android:layout_marginBottom="80dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/surface"
            android:elevation="8dp"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/rfid_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡 RFID正在扫描..."
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- 左侧任务历史面板 -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 面板标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/primary">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="盘点任务"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="最近7次记录"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:alpha="0.8"/>

            </LinearLayout>

            <!-- 任务列表 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_list_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="16dp"
                tools:listitem="@layout/item_inventory_task"/>

            <!-- 刷新按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh_tasks_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:text="刷新任务"
                android:textSize="14sp"
                app:cornerRadius="6dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/primary"
                android:textColor="@color/primary"/>

        </LinearLayout>

    </com.google.android.material.navigation.NavigationView>

</androidx.drawerlayout.widget.DrawerLayout>
