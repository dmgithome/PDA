<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_custom" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="?attr/actionBarSize">

        <!-- 顶部状态提示（与其他界面保持一致） -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 顶部条码框（与取用一致的交互） -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/border">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/barcode_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/inbound_barcode_hint"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:inputType="textNoSuggestions"
                android:importantForAutofill="no"
                android:autoText="false"
                android:ellipsize="end"
                android:textSize="14sp"
                android:nextFocusUp="@id/barcode_input"
                android:nextFocusDown="@id/barcode_input"
                android:nextFocusLeft="@id/barcode_input"
                android:nextFocusRight="@id/barcode_input"
                android:nextFocusForward="@id/barcode_input" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 移除屏内RFID控制按钮，统一使用物理键切换 -->

        <ProgressBar
            android:id="@+id/loading"
            style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/inventory_no_tasks"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="12dp"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inbound_order_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/surface"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clipToPadding="false"
            android:paddingBottom="12dp"/>

        <!-- 水平滚动展示本轮读取到的 EPC（与条码框等高） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_rfid_epc_scroller"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rfid_section_height"
            android:visibility="gone"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:layout_marginTop="8dp"/>

        <!-- 底部启动/停止 RFID 盘点按钮（禁用时显示原因） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_rfid"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rfid_section_height"
            android:text="启动RFID盘点"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_marginTop="8dp"
            android:textColor="@color/rfid_toggle_text_idle"
            app:backgroundTint="@color/rfid_toggle_idle"
            app:cornerRadius="8dp"
            app:strokeWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <TextView
            android:id="@+id/rfid_power_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/rfid_power_hint"
            android:textColor="@color/rfid_toggle_text_idle"
            android:textSize="12sp"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
