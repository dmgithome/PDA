<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ConsumableTransferActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="4dp">

        <include
            android:id="@+id/toolbar"
            layout="@layout/toolbar_custom" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="?attr/actionBarSize">

        <!-- 顶部状态提示 -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 目标中心库选择 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/target_center_input_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <AutoCompleteTextView
                android:id="@+id/target_center_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/transfer_target_center_hint"
                android:textSize="14sp"
                android:inputType="none"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 条码输入框 -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/barcode_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/transfer_scan_hint"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:inputType="textNoSuggestions"
                android:importantForAutofill="no"
                android:autoText="false"
                android:ellipsize="end"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 移库明细列表（按源中心库+子码聚合） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/transfer_detail_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_consumable_detail"/>

        <!-- 底部汇总与操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/transfer_summary_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:text="@string/transfer_total_default"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/transfer_clear_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/transfer_clear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/transfer_submit_button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/transfer_submit"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>

        <!-- 水平滚动展示本轮读取到的 EPC -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_rfid_epc_scroller"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rfid_section_height"
            android:visibility="gone"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:layout_marginTop="8dp"/>

        <!-- 启动/停止 RFID 扫描按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_rfid"
            android:layout_width="match_parent"
            android:layout_height="@dimen/rfid_section_height"
            android:text="@string/inbound_start_rfid"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_marginTop="8dp"
            android:textColor="@color/rfid_toggle_text_idle"
            app:backgroundTint="@color/rfid_toggle_idle"
            app:cornerRadius="8dp"
            app:strokeWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>

        <TextView
            android:id="@+id/rfid_power_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/rfid_power_hint"
            android:textColor="@color/rfid_toggle_text_idle"
            android:textSize="12sp"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

